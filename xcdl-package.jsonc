{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2022-2026 Liviu Ionescu. All rights reserved.",
  "description": "Top QEMU RISC-V components",
  "cdlComponents": [
    {
      "id": "micro-os-plus.devices.qemu-riscv",
      "alias": "micro-os-plus.device",
      "display": "QEMU RISC-V devices",
      "description": "The QEMU RISC-V devices definitions",
      "publicIncludeFolders": [
        "include"
      ],
      "sourceFiles": [
        "src/reset-entry.S"
      ],
      // Clarify how to use the device definition, known in the platform.
      "dependencies": [
        // "micro-os-plus.diag.trace",
        "micro-os-plus.architecture"
      ],
      "implementedInterfaces": [
        "micro-os-plus.device"
      ],
      "generatedFile": {
        "type": "c-header",
        "filePath": "{{buildFolderPath}}/generated/include/micro-os-plus/device-defines.h"
      },
      // "defaultDefine": "MICRO_OS_PLUS_DEVICES_QEMU_RISCV_ENABLED",
      "cdlOptions": [
        {
          "id": "core",
          "display": "CPU core",
          "description": "Select the QEMU RISC-V CPU",
          "valueType": "string",
          "legalValues": [
            "RV32IMAC",
            "RV64IMAFDC"
          ],
          "customDefine": "MICRO_OS_PLUS_DEVICE_QEMU_RISCV"
        }
      ]
    }
  ]
}